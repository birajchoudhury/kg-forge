# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here  # Optional, for temporary credentials
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_NAME=anthropic.claude-3-haiku-20240307-v1:0

# Application Configuration
LOG_LEVEL=INFO
DEFAULT_NAMESPACE=default

# Extraction Configuration
DEFAULT_EXTRACTOR=llm
DEFAULT_DEDUP_BACKEND=splink

# Hyland Knowledge Enrichment Configuration (Optional)
# Obtain credentials from https://admin.experience.hyland.com/
HYLAND_KE_CLIENT_ID=your_hyland_client_id_here
HYLAND_KE_CLIENT_SECRET=your_hyland_client_secret_here
# Optional: Override default endpoints
# HYLAND_KE_API_URL=https://knowledge-enrichment.ai.experience.hyland.com/latest/api/data-curation
# HYLAND_KE_OAUTH_URL=https://auth.iam.experience.hyland.com/idp
# Optional: Curation options
# HYLAND_KE_ENABLE_CHUNKING=false
# HYLAND_KE_CHUNK_SIZE=1000
# HYLAND_KE_ENABLE_EMBEDDINGS=false
# HYLAND_KE_NORMALIZE_QUOTATIONS=true
# HYLAND_KE_NORMALIZE_DASHES=true
